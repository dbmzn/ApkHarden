<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:label="Default Fixture">
        <activity
            android:name=".SmokeActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <provider
            android:name=".MainProbeProvider"
            android:authorities="${applicationId}.main-probe"
            android:exported="true" />
        <provider
            android:name=".WorkerProbeProvider"
            android:authorities="${applicationId}.worker-probe"
            android:exported="true"
            android:process=":worker" />
    </application>
</manifest>
